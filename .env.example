# Copy to .env and adjust for local/docker use.

API_KEY=change-me-demo-key
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://payments:payments@localhost:5672/

# Comma-separated exact hostnames allowed for webhook_url (HTTPS in production).
WEBHOOK_ALLOWED_HOSTS=webhook.site,example.org

# Optional tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
RABBITMQ_PREFETCH=10
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_SEC=1.0
OUTBOX_CLAIM_SEC=30
OUTBOX_PUBLISH_TIMEOUT_SEC=5
GATEWAY_SLEEP_MIN_SEC=2
GATEWAY_SLEEP_MAX_SEC=5
WEBHOOK_TIMEOUT_SEC=10
WEBHOOK_MAX_RESPONSE_BYTES=65536
ENABLE_OPENAPI=false
